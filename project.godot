; Engine configuration file.
; Shadowfetch Blackjack — Godot 4.7
config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Shadowfetch Blackjack"
config/description="A premium standalone 3D blackjack table for Linux. Fictional currency only."
config/version="2.0.0"
run/main_scene="res://scenes/boot.tscn"
config/auto_accept_quit=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

SettingsStore="*res://scripts/save/settings_store.gd"
StatsStore="*res://scripts/save/stats_store.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/size/mode=0

[gui]

common/snap_controls_to_pixels=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.035, 1)
anti_aliasing/quality/use_taa=false
textures/canvas_textures/default_texture_filter=2
